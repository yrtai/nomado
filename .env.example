# ── API (apps/api) ──────────────────────────────────────────────
# Port the API listens on
PORT=4000
# Local Postgres from docker-compose (used from Phase 1 on)
DATABASE_URL=postgresql://nomado:nomado@localhost:5432/nomado
# Local Redis from docker-compose (used from Phase 1 on)
REDIS_URL=redis://localhost:6379

# ── Web (apps/web) ──────────────────────────────────────────────
# Where the browser can reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000
